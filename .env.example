# ===== AgentFlow 主后端 =====
# 精简版默认跑在 8002，完整版默认 8001
AGENTFLOW_BASE_URL=http://127.0.0.1:8001

# 用一个专门的服务账号（建议在设置页单独建一个），不要用管理员日常账号
AGENTFLOW_EMAIL=
AGENTFLOW_PASSWORD=

# 默认 Agent：注册时会自动创建一个 "PHAiagent"，可以填它的 id
# 单个任务也可以在 POST /tasks 时用自己的 agent_id 覆盖
AGENTFLOW_AGENT_ID=

# ===== 默认推送 =====
# 新建任务时若未指定，就用这两个值
# kind=email 时，DEFAULT_WEBHOOK_URL 填收件人邮箱（可逗号分隔多个）
DEFAULT_WEBHOOK_URL=
# generic / wecom（企业微信）/ dingtalk（钉钉）/ feishu（飞书）/ email（邮件）
DEFAULT_WEBHOOK_KIND=generic

# ===== 邮件通道（kind=email）=====
# 留空会自动回退读取主项目的 MAIL_HOST / MAIL_PORT / MAIL_USER / MAIL_PASSWORD / MAIL_FROM，
# 已经配好发信的部署不用重复填。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# QQ 邮箱 / 163 等用的是「授权码」，不是登录密码
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=PHAiagent
# 465 端口用 true（SSL）；587 端口用 false（走 STARTTLS）
SMTP_USE_SSL=true
SMTP_TIMEOUT=20
# 任务的 webhook_url 留空时，默认发给谁（逗号分隔）
MAIL_TO=

# ===== 服务自身 =====
# 调度时区：决定「几点执行」和「今天跑过没有」，服务器时区不对也不会错点
TZ=Asia/Shanghai
HOST=127.0.0.1
PORT=8010
# 调度检查间隔（秒）
TICK_SECONDS=30
# 任务 / 历史 / 待确认的存放目录，相对本目录
DATA_DIR=data

# ===== 对外地址与事件验签 =====
# 审批确认链接用它拼；部署到公网务必改成真实域名，否则链接指向 127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8010
# GitHub webhook 的 X-Hub-Signature-256 校验密钥；留空不校验，仅适合内网
WEBHOOK_SECRET=
